# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*$py.class
.Python
.venv/
venv/
env/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Logs and runtime outputs
logs/
work/
*.log

# BirdNET outputs
*.BirdNET.results.csv

# Local config backup
config.local.yaml
config.*.local.yaml

# Audio recordings generated by app
work/birdnet_in/
work/birdnet_out/
work/mimic_recordings/

# Large or temporary audio files
*.mp3
*.m4a
*.aiff
*.flac

# reference_sounds 内の WAV は原則除外
reference_sounds/*.wav
# ただし、デモ用のお手本音声 scene WAV は Git 管理する
!reference_sounds/*_scene*.wav
# reference_sounds 内の作業用ファイルは除外
reference_sounds/*.xlsx
reference_sounds/*.xls
reference_sounds/*.sh
reference_sounds/*.zip
reference_sounds/*.txt

# 空ディレクトリ維持用
!reference_sounds/.gitkeep
!logs/.gitkeep
!work/.gitkeep
!work/birdnet_in/.gitkeep
!work/birdnet_out/.gitkeep
!work/mimic_recordings/.gitkeep

test_out_lowconf/
tools/*.wav
